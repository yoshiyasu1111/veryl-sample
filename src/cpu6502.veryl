module cpu6502 (
    clk : input clock,
    rst : input reset,
    bus : modport bus_if::<8, 16>::master,
) {

    // ============================================================
    // Registers & Internal Latches
    // ============================================================
    var a  : logic<8>;
    var x  : logic<8>;
    var y  : logic<8>;
    var sp : logic<8>;
    var pc : logic<16>;
    var p  : logic<8>;
    var opcode : logic<8>;
    var tstate : logic<4>;
    var addr_latch : logic<16>;

    enum cpu_state_t {
        RESET,
        EXEC,
    }
    var cpu_state: cpu_state_t;

    always_ff {
        if_reset {
            cpu_state = cpu_state_t::RESET;
        } else {            
            cpu_state = cpu_state_t::EXEC;
        }
    }
    enum addr_src_t {
        NORMAL,
        ABSOLUTEX,
        ADJUST,
    }
    struct ctrl_t {
        load_ir  : logic,
        load_a   : logic,
        load_x   : logic,
        load_y   : logic,
        load_lo  : logic,
        addr_src : addr_src_t,
        end_inst : logic,
        len      : logic<3>,
    }
    var ctrl: ctrl_t;

    always_comb {
        bus.wen   = 0;
        bus.wdata = 0;
        if cpu_state == cpu_state_t::EXEC {
            case ctrl.addr_src {
                addr_src_t::NORMAL    : bus.addr = pc + tstate + 1;
                addr_src_t::ABSOLUTEX : bus.addr = {bus.rdata, addr_latch[7:0]} + x;
                addr_src_t::ADJUST    : bus.addr = pc + tstate;
            }
        } else {
            bus.addr = pc;
        }
        bus.valid = 1;
    }

    function get_ctrl(op: input logic<8>, t: input logic<4>) -> ctrl_t {
        var c: ctrl_t;

        case op {
            8'hA9: {    // LDA imm
                case t {
                    4'd0: c = ctrl_t'{ load_ir: 1, ..default(0) };
                    4'd1: c = ctrl_t'{ load_a: 1, end_inst: 1, len: 2, ..default(0) };
                }
            }
            8'hBD: {    // LDA abs,x
                case t {
                    4'd0: c = ctrl_t'{ load_ir: 1, ..default(0) };
                    4'd1: c = ctrl_t'{ load_lo: 1, ..default(0) };
                    4'd2: c = ctrl_t'{ addr_src: addr_src_t::ABSOLUTEX, ..default(0) };
                    4'd3: c = ctrl_t'{ load_a: 1, end_inst: 1, addr_src: addr_src_t::ADJUST, len: 3, ..default(0) };
                }
            }
            8'hA2: {    // LDX imm
                case t {
                    4'd0: c = ctrl_t'{ load_ir: 1, ..default(0) };
                    4'd1: c = ctrl_t'{ load_x: 1, end_inst: 1, len: 2, ..default(0) };
                }
            }
            8'hA0: {    // LDY imm
                case t {
                    4'd0: c = ctrl_t'{ load_ir: 1, ..default(0) };
                    4'd1: c = ctrl_t'{ load_y: 1, end_inst: 1, len: 2, ..default(0) };
                }
            }
            default: {
                c = '0;
            }
        }
        return c;
    }
    always_comb {
        ctrl = get_ctrl(if cpu_state == cpu_state_t::EXEC && tstate == 0 ? bus.rdata : opcode, tstate);
    }

    function update_nz(value: input logic<8>) {
        p[1] = value == 0;
        p[7] = value[7];
    }
    
    always_ff {
        if_reset {
            a = 0; x = 0; y = 0; sp = 0; p = 0;
            pc = 0;
            tstate = 0;
            addr_latch = 0;
        } else {
            if bus.ready {
                if cpu_state == cpu_state_t::EXEC {
                    if ctrl.load_ir {
                        opcode = bus.rdata;
                    }
                    if ctrl.load_a {
                        a = bus.rdata;
                        update_nz(bus.rdata);
                    }
                    if ctrl.load_x {
                        x = bus.rdata;
                        update_nz(bus.rdata);
                    }
                    if ctrl.load_y {
                        y = bus.rdata;
                        update_nz(bus.rdata);
                    }
                    if ctrl.load_lo {
                        addr_latch[7:0] = bus.rdata;
                    }
                    if ctrl.end_inst {
                        tstate = 0;
                    } else {
                        tstate += 1;
                    }
                    if ctrl.end_inst {
                        pc += ctrl.len;
                    }
                }
            }
        }
    }

    always_ff {
        $display("pc %h, a %h, x %h, y %h, p %h, sp %h, opcode %h, cpu_state %h, bus.addr %h, bus.rdata %h, tstate %h, ctrl.load_ir %h, ctrl.load_a %h, ctrl.load_x %h, ctrl.load_y %h, ctrl.load_lo %h, ctrl.addr_src %h, ctrl.end_inst %h",
                  pc,    a,    x ,   y,    p,    sp,    opcode,    cpu_state,    bus.addr,    bus.rdata,    tstate ,   ctrl.load_ir,    ctrl.load_a,    ctrl.load_x,    ctrl.load_y,    ctrl.load_lo,    ctrl.addr_src,    ctrl.end_inst
        );
    }
}

#[test(test_cpu6502)]
module test_cpu6502 {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen (clk);

    inst bus: bus_if::<8, 11>;

    inst mem: memory::<8, 11> #(
        FILE_PATH: "../hex/test_lda.hex",
    ) (
        clk: clk,
        rst: rst,
        bus: bus,
    );

    inst dut: cpu6502 (
        clk,
        rst,
        bus: bus,
    );

    initial {
        rst.assert();
        clk.next (10);

        $display("cpu6502 test passed");
        $finish ();
    }
}
