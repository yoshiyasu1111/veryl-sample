module top (
    i_clk : input clock,
    i_rst : input reset,
) {
    var counter: logic<8>;

    always_ff {
        if_reset {
            counter = 0;
        } else {
            counter += 1;
        }
    }
}

#[test(test_top)]
module test_top {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen (clk);

    inst dut: top (
        i_clk: clk,
        i_rst: rst,
    );

    initial {
        rst.assert();
        clk.next (10);
        $finish ();
    }
}
